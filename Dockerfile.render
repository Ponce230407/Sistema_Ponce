FROM php:8.2-apache

# Instalar y habilitar la extensión mysqli para conectar con MySQL/MariaDB
RUN docker-php-ext-install mysqli && docker-php-ext-enable mysqli

# Copiar los archivos del proyecto al directorio web de Apache
COPY . /var/www/html/

# Configurar permisos para Apache
RUN chown -R www-data:www-data /var/www/html

# Exponer el puerto estándar 80 del contenedor web
EXPOSE 80
